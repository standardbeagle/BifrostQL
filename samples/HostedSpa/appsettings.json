{
  "ConnectionStrings": {
    "bifrost": "Data Source=hostedspa-sample.db"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  // Optional OIDC login (Google / Microsoft 365). Left commented out so the sample runs
  // on local auth only — Program.cs only wires OIDC when an "Oidc" section is present.
  // To enable, uncomment and supply a real issuer (and the matching AddOpenIdConnect
  // client id/secret). OIDC logins map to the same AppIdentity local auth produces, so
  // app authorization semantics are unchanged.
  // "Oidc": {
  //   "Microsoft365": { "Issuer": "https://login.microsoftonline.com/<tenant-id>/v2.0" },
  //   "Google": { "Issuer": "https://accounts.google.com" }
  // },
  "BifrostQL": {
    "Path": "/graphql",
    "Playground": "/playground",
    "DisableAuth": true,
    "Provider": "sqlite",
    "Metadata": [
      // The membership-manager guard shapes, one metadata line each. The app is
      // closed by default; every line below opens exactly one thing. Grants are
      // the union of a login's roles and the permissions Program.cs resolves for
      // them (officer -> members.manage, events.manage; finance -> dues.manage).
      ":root { auto-join: true; de-pluralize: false; default-limit: 100; policy-default: deny; }",
      // The SPA's widget demo stays readable without a login.
      "main.widgets { policy-actions: read }",
      // Role-backed grants: the operational tables are open to every signed-in caller.
      "main.members, main.member_memberships, main.membership_plans, main.dues_invoices, main.dues_payments, main.event_attendance { policy-actions: read,create,update,delete }",
      // Append-only audit trail: the workflows append, nobody edits or deletes.
      "main.audit_log { policy-actions: read,create }",
      // Officer-only content deletion.
      "main.events { policy-actions: read,create,update,delete[events.manage] }",
      // Finance-only money writes: sending amount_cents at all is a write.
      "main.dues_payments.amount_cents { write-requires: dues.manage }",
      // Masked reads: who holds which role is visible to officers; others read null.
      "main.app_users { policy-actions: read,update[members.manage]; policy-self-deny: roles }",
      "main.app_users.roles { read-requires: members.manage; deny-mode: null }",
      // Own-member rows, with the officer grant exempt from the row predicate.
      "main.members { policy-row-scope: user_id = {user_id}; policy-row-scope-exempt: members.manage }",
      // Constrained status: an invoice status is one of a closed set.
      "main.dues_invoices.status { writable-values: open,paid,void }",
      "main.members { state-column: status; initial-state: pending; states: pending,active,inactive,deceased; transitions: pending->active[officer,admin]@member.activated|active->inactive[officer,admin]@member.inactivated|inactive->active[admin]@member.reactivated|active->deceased[officer,admin]@member.deceased|inactive->deceased[officer,admin]@member.deceased }",
      "main.events { state-column: status; initial-state: draft; states: draft,published,cancelled; transitions: draft->published[event_manager,admin]@event.published|published->cancelled[event_manager,admin]@event.cancelled|draft->cancelled[event_manager,admin]@event.cancelled }"
    ]
  }
}
