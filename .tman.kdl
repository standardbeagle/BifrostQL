// Supervision policy for BifrostQL.
//
// Read this before changing a number: the PATH shims re-issue `dotnet test`,
// `pnpm test` and friends as their own nested `tman run` with NO flags, so a
// nested run is governed by THIS `defaults` block and nothing else. Caps set
// on an alias below — or passed on the command line — apply only to the outer
// wrapper process and never reach the build/test that actually burns the
// resources. That is why the ceilings live in `defaults` and are sized for the
// heaviest workload in the repo rather than the typical one.

defaults {
    // Hang backstop, NOT a runtime budget. `dotnet test BifrostQL.sln` restores
    // and builds three TFMs of the multi-targeted src libraries before printing
    // anything, and the release tier compounds that across the full matrix.
    // (The scaffolded 60s was a runtime budget wearing a backstop's name.)
    stall "30m"

    // Runaway guard only, sized for the heaviest run in the repo: the release
    // tier's nested `dotnet test` from a cold build. On build3 (32 cores, the
    // fleet's widest box, so the most MSBuild nodes) that peaked at 10943MB
    // (2026-11-23, bin/obj removed, build server shut down); 8192 culled four
    // such runs at 8228-9243MB. A warm rerun peaks at 5356MB and an epic run
    // at ~2.1GB. 16384 is 1.5x the cold peak and still stops a leak well before
    // it threatens a 28GB runner.
    max-mem 16384

    // No `max-cpu` on purpose. tman normalises CPU% across all cores, so the
    // scaffolded 95 meant "kill anything that saturates the machine" — exactly
    // what a healthy parallel build or a threaded vitest run is supposed to do.
    // It is also sampled on the root process only, so it fires or not depending
    // on whether the work happens in the wrapper or a child: a cull that lands
    // unpredictably teaches nothing. Bound runtime with `max-time` instead.

    // Two concurrent runs per bucket. Slots are scoped per bucket-and-directory,
    // so this never contends with a run in another checkout.
    max-parallel 2

    // Suites here run for minutes, and with only two slots a queued run must be
    // able to outwait the one ahead of it. The 5m built-in expires while a run
    // is legitimately waiting its turn.
    queue-timeout "30m"

    retain "24h"
}

// Default gate: every test project on the current TFM, Fuzz excluded. Extra args
// pass through, so `./test tests/BifrostQL.Server.Test` scopes it to one project.
// Deliberately not `npm run test` — this repo is pnpm-only, and the root test
// script bypasses the epic/release tier split these scripts exist to enforce.
//
// cores/mem are a floor under the queue's measured history, which sees only
// this run's process tree. The integration suites' SQL work runs in the
// docker-compose.test.yml containers under dockerd, and reused MSBuild nodes /
// VBCSCompiler compile outside the tree too. Measured on build3 (32 cores),
// 2026-11-23, steady-state run: tree 339 cpu-s, peak 7525MB; the three
// databases' cgroups 127 cpu-s and +634MB; 37s wall = 12.8 cores (40%),
// 8159MB. A percentage, because MSBuild and the test hosts fan out per core.
alias "test" {
    command "./scripts/test-epic.sh"
    max-time "30m"
    cores "40%"
    mem "8159m"
}

// JS workspace only: 7 packages, ~1800 vitest tests. Useful when a change is
// frontend-only and the .NET gate is not implicated.
alias "test-js" {
    command "pnpm"
    args "test:js"
    max-time "20m"
}

// Release tier: the full net8.0/net9.0/net10.0 matrix plus the Fuzz category,
// gated before pack-publish. The script brings up docker-compose.test.yml first;
// the Integration project reads the connection strings from its runsettings.
//
// Floor: memory is the release tier's measured cold-build peak, 10943MB on
// build3 (32 cores, 2026-11-23, bin/obj removed). The test containers run
// under dockerd, outside the tree, so the booking stays a lower bound. Cores
// stay at the epic tier's measured share (see `test`).
alias "test-release" {
    command "./scripts/test-release.sh"
    max-time "90m"
    cores "40%"
    mem "10943m"
}

// Floor: reused MSBuild nodes and VBCSCompiler do this build's compiling outside
// the run's tree. Measured on build3 (32 cores), 2026-11-23, a clean build with
// node reuse and shared compilation off so all of it stayed in the tree:
// 669 cpu-s over 35s = 19.3 cores (60%), peak 7995MB.
alias "build" {
    command "dotnet"
    args "build" "BifrostQL.sln"
    max-time "30m"
    cores "60%"
    mem "7995m"
}

// Test inventory: every test name in the repo, both stacks, one per line on
// stdout. The automation loop diffs a plan's declared test names against this
// without knowing what a test framework is.
//
// Floor: its `dotnet build` compiles in reused MSBuild nodes outside the tree.
// Measured on build3, 2026-11-23, incremental build with reuse off: 15 cpu-s
// over 13s = 1.2 cores, peak 4719MB (the vitest half failed in that fresh
// clone, so this covers the .NET half; vitest runs in the tree).
alias "list-tests" {
    command "./scripts/list-tests.sh"
    max-time "30m"
    cores 1.2
    mem "4719m"
}

// Run exactly the test(s) named by $1, an exact name as printed by list-tests.
// Floor, same reason as list-tests. Measured on build3, 2026-11-23, one .NET
// test with node reuse off: 11 cpu-s over 7s = 1.6 cores, peak 5521MB.
alias "test-by-name" {
    command "./scripts/test-by-name.sh"
    max-time "30m"
    cores 1.6
    mem "5521m"
}
