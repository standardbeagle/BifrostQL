<Project Sdk="Microsoft.NET.Sdk">

	<!--
	  Criterion 1 proof project. This assembly is INTENTIONALLY absent from
	  BifrostQL.Core's InternalsVisibleTo list (Core grants internals only to
	  BifrostQL.Core.Test / BifrostQL.Server / BifrostQL.Sqlite / BifrostQL.SqlServer).
	  It therefore stands in for an external third-party module: everything it uses —
	  the SqlExpr nodes, the SqlExprBuilder fluent surface, the ISqlDialect lowering
	  entry point — must be PUBLIC, or this project fails to COMPILE. A green build here
	  is the compile-time guarantee that the expression-builder API needs no Core internals.
	-->
	<PropertyGroup>
		<TargetFrameworks Condition="'$(ReleaseTests)'=='true'">net8.0;net9.0;net10.0</TargetFrameworks>
		<TargetFramework Condition="'$(ReleaseTests)'!='true'">net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="FluentAssertions" Version="8.10.0" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
		<PackageReference Include="xunit" Version="2.9.3" />
		<PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
		<PackageReference Include="coverlet.collector" Version="10.0.1">
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
	</ItemGroup>

	<!--
	  References Core (for the public builder + nodes + IDbTable/DbTable/ColumnDto) and the
	  four shipped dialect assemblies (for their public LowerExpression). No reference to
	  BifrostQL.Core.Test or BifrostQL.Testing — an external module would have neither, and
	  neither grants this project any internals view onto Core.
	-->
	<ItemGroup>
		<ProjectReference Include="..\..\src\BifrostQL.Core\BifrostQL.Core.csproj" />
		<ProjectReference Include="..\..\src\data\BifrostQL.Ngsql\BifrostQL.Ngsql.csproj" />
		<ProjectReference Include="..\..\src\data\BifrostQL.Sqlite\BifrostQL.Sqlite.csproj" />
		<ProjectReference Include="..\..\src\data\BifrostQL.MySql\BifrostQL.MySql.csproj" />
		<ProjectReference Include="..\..\src\data\BifrostQL.SqlServer\BifrostQL.SqlServer.csproj" />
	</ItemGroup>

</Project>
