<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsPublishable>False</IsPublishable>
		<IsPackable>true</IsPackable>
		<PackageVersion>0.4.11</PackageVersion>
		<PackageId>BifrostQL.SqlServer</PackageId>
		<Authors>Andy Brummer</Authors>
		<Company>StandardBeagle</Company>
		<Description>SQL Server dialect support for BifrostQL.</Description>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
		<!-- Microsoft.Data.SqlClient pulls System.Security.Cryptography.Pkcs 8.0.1 (net8) and
		     9.0.x (net9/net10), inside CVE-2026-84008 / CVE-2026-70162; no SqlClient release
		     depends on a patched build yet. Pin the patched build per TFM until it does. -->
		<PackageReference Include="System.Security.Cryptography.Pkcs" Version="8.0.2" Condition="'$(TargetFramework)'=='net8.0'" />
		<PackageReference Include="System.Security.Cryptography.Pkcs" Version="9.0.21" Condition="'$(TargetFramework)'=='net9.0'" />
		<PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" Condition="'$(TargetFramework)'=='net10.0'" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="BifrostQL.Core.Test" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\BifrostQL.Core\BifrostQL.Core.csproj" />
	</ItemGroup>

</Project>
